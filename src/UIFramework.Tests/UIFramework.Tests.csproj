<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UIFramework\UIFramework.csproj" />
  </ItemGroup>

  <!-- AdoptTests writes backup zips as Streamer.bot does. Part of .NET Framework, as in the DLL's own project. -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host block a game pastes in, compiled here against a stand-in for Streamer.bot's CPH (HostBlock/Streamerbot.cs). -->
    <Compile Include="..\..\stub\HostSchema.cs" Link="HostBlock\HostSchema.cs" />
  </ItemGroup>

  <!-- The settings action (stub/Stub.cs), compiled here too, so it is tested without a Streamer.bot: Streamer.bot gives
       an action's class its base (with CPH in it) when it compiles it; here the class gets a stand-in for that base
       (HostBlock/StubBase.cs) and another name, since it is not the only CPHInline a test project may meet. -->
  <Target Name="StubUnderTest" BeforeTargets="CoreCompile" Inputs="..\..\stub\Stub.cs;$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)StubUnderTest.g.cs">
    <PropertyGroup>
      <StubSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\stub\Stub.cs'))</StubSource>
      <StubPatched>$(StubSource.Replace('public class CPHInline', 'public class StubUnderTest : UIFramework.Tests.StubBase').Replace('CPHInline', 'StubUnderTest'))</StubPatched>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)StubUnderTest.g.cs" Lines="$([MSBuild]::Escape($(StubPatched)))" Overwrite="true" />
  </Target>
  <Target Name="StubUnderTestCompile" BeforeTargets="CoreCompile" DependsOnTargets="StubUnderTest">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)StubUnderTest.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The host reader (stub/HostReader.cs) declares UiSettings as the host block does, since an action carries one of
       the two. Here both are compiled, so the reader's class gets another name. -->
  <Target Name="ReaderUnderTest" BeforeTargets="CoreCompile" Inputs="..\..\stub\HostReader.cs;$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)ReaderUnderTest.g.cs">
    <PropertyGroup>
      <ReaderSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\stub\HostReader.cs'))</ReaderSource>
      <ReaderPatched>$(ReaderSource.Replace('UiSettings', 'UiReaderSettings'))</ReaderPatched>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ReaderUnderTest.g.cs" Lines="$([MSBuild]::Escape($(ReaderPatched)))" Overwrite="true" />
  </Target>
  <Target Name="ReaderUnderTestCompile" BeforeTargets="CoreCompile" DependsOnTargets="ReaderUnderTest">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ReaderUnderTest.g.cs" />
    </ItemGroup>
  </Target>

</Project>
